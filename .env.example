# API
API_LISTEN=:8080


# Auth (required)
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_REDIRECT_URL=
AUTH_SECURE_COOKIES=true

# Mongo (required)
MONGO_URI=
MONGO_DB=
MONGO_USERS_COLLECTION=users
MONGO_MEDIA_COLLECTION=media
MONGO_JOBS_COLLECTION=jobs
MONGO_PROCESSED_TASKS_COLLECTION=processed_tasks
MONGO_PING_TIMEOUT=5s

# Bot (required)
BOT_TOKEN=
BOT_CHANNEL_ID=
BOT_CHANNEL_ACCESS_HASH=

# Telegram (required)
TELEGRAM_APP_ID=
TELEGRAM_APP_HASH=
TELEGRAM_SOCKS_PROXY=
TELEGRAM_SESSION_DIR=sessions

# Worker (required; comma-separated tokens)
WORKER_TOKENS=
WORKER_SESSION_PREFIX=worker
WORKER_TEMP_DIR=

# NATS
NATS_URL=nats://127.0.0.1:4222
NATS_STREAM=GLIDE_MEDIA
NATS_ACK_WAIT=30m
NATS_MAX_DELIVER=5

# MinIO
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=glide
MINIO_USE_SSL=false

# Byse
BYSE_BASE_URL=https://api.byse.sx
BYSE_API_KEY=
BYSE_TIMEOUT=30s
BYSE_UPLOAD_TIMEOUT=30m
